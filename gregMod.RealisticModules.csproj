<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>gregMod.RealisticModules</AssemblyName>
    <RootNamespace>GregModMoreModules</RootNamespace>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <NoWarn>CS0618;CS0672</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader" HintPath="references/MelonLoader.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="references/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="references/0Harmony.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="references/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="references/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="references/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="references/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="references/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="references/UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="references/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="references/Unity.InputSystem.dll" Private="false" />
  </ItemGroup>
</Project>
